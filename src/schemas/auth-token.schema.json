{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auth-token",
  "title": "AuthToken",
  "description": "Successful response of POST /auth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": { "type": "string", "pattern": "^[a-zA-Z0-9]{8,}$" }
  }
}
